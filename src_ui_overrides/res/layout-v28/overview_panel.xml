<?xml version="1.0" encoding="utf-8"?>
<!--
     Defensive stub. Nothing in this variant should provide a -v28 overview_panel any more (the
     quickstep one lives in quickstep/res_views, which only withQuickstep compiles), so the base
     res/layout/overview_panel.xml would apply. This keeps the -v28 qualifier pinned to a Space so
     that re-adding a quickstep layout under quickstep/res cannot silently make this variant
     inflate LauncherRecentsView, a class it does not compile.
-->
<Space
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:visibility="gone" />
