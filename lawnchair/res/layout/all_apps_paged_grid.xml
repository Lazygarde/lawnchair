<?xml version="1.0" encoding="utf-8"?>
<!-- Paged app drawer (config_drawer_paged): the pages and their dots, in place of the A-Z list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/all_apps_paged_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <app.lawnchair.allapps.paged.AllAppsPagedGrid
        android:id="@+id/all_apps_paged_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false" />

    <app.lawnchair.allapps.paged.DrawerPageDots
        android:id="@+id/all_apps_paged_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp" />
</LinearLayout>
