<?xml version="1.0" encoding="utf-8"?>
<!--
  Values the hosting app is expected to override, either with a resValue in its build script or
  with a resource of the same name. They exist here so the library compiles on its own.
-->
<resources>
    <!--
      "<applicationId>/app.lawnchair.LawnchairLauncher". Used to keep the launcher itself out of
      the app drawer, so an empty default only means the launcher lists itself.
    -->
    <string name="launcher_component" translatable="false"></string>

    <!-- Distribution channel; "play" turns off the in-app updater. -->
    <string name="config_release_channel" translatable="false">play</string>
    <!--
      Whether to exclude the current (hosting) app from showing the long-click popup menu.
      Default is true to prevent users from easily uninstalling or accessing app info of the hosting app.
    -->
    <bool name="config_exclude_current_app_from_popup" translatable="false">true</bool>

    <!-- Additional package names to exclude from popup menu -->
    <string-array name="config_popup_excluded_packages" translatable="false">
    </string-array>

    <!--
      Whether to enable host-provided in-process minus-one overlay screen.
      If true and an overlay provider is registered in LawnchairOverlayRegistry,
      the custom overlay will take precedence on the minus-one screen.
    -->
    <bool name="config_enable_custom_overlay" translatable="false">true</bool>

    <!--
      Whether to show the built-in AI Cleaner minus-one dashboard when no host overlay provider
      is registered in LawnchairOverlayRegistry.
    -->
    <bool name="config_enable_ai_cleaner_minus_one" translatable="false">true</bool>

    <!--
      Master switch for host-provided slots (ads or regular content) in the app drawer. Even when true, nothing is shown until a
      provider is registered in LawnchairDrawerSlotRegistry and it enables the slot type.
    -->
    <bool name="config_enable_drawer_slots" translatable="false">false</bool>

    <!-- Minimum search query length before the host is asked for search slot items. -->
    <integer name="config_drawer_slot_search_min_query" translatable="false">2</integer>

    <!--
      Theme overlay applied to the context used to inflate drawer slot views (see
      DrawerSlotEnv.themedContext). The launcher activity theme is not AppCompat/Material, so a host
      whose slot layouts use MaterialButton etc. overrides this style with the same name, e.g.
      parent="Theme.Material3.DayNight.NoActionBar". The default is empty, i.e. the launcher theme.
    -->
    <style name="LawnchairDrawerSlotTheme" />

    <!--
      Spacing owned by the library so every slot looks consistent and hosts just return a
      MATCH_PARENT-width view. Side insets are not configurable: slots always align with the app
      grid edges (header, footer, inline) or with the search result cards (search).
      Vertical gap above AND below an inline slot in the app grid.
    -->
    <dimen name="drawer_slot_vertical_spacing_inline">8dp</dimen>
    <!-- Vertical gap above AND below a search slot (result groups are about 17dp apart). -->
    <dimen name="drawer_slot_vertical_spacing_search">12dp</dimen>
    <!-- Gap between the list and the footer slot's view. -->
    <dimen name="drawer_slot_footer_top_spacing">4dp</dimen>
</resources>
